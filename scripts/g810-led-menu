#!/usr/bin/env bash

# Author: Barret E <https://github.com/archusXIV>
#
# This script let us create, delete, switch between RGB profiles
# designed to be use with our Logitech compatible keyboard.
# Supported keyboards: G213 G410 G413 G512 G513 G610 G810 G815 G910 Gpro
# Themes, profiles and "skeletons" can be edited through the menu too.
# use lsusb | grep -i keyboard, to find out your model name & model id

# shellcheck disable=SC2024
myModelName=$(awk '/Keyboard/{print $9}' < <(lsusb))
myModelBinary="${myModelName,}-led"
G=$'\e[32m'
R=$'\e[31m'
Z=$'\e[0m'

! grep -q "$myModelName" < <(lsusb) && {
    [[ -z $(command -v "$myModelBinary") ]] && {
        printf '%s\n' " ${R}No g810-led related binary found...exiting${Z}"
        exit 127
    }
    printf '%s\n' " ${R}$myModelName is not plugged in, exiting...${Z}"
    exit 1
}

etc_confdir="/etc/g810-led"
etc_profiles="$etc_confdir/profiles"
profile=$(sed -n '1s/# //p' "$etc_confdir"/profile)
config_dir="$HOME/.config/g810-led"
groups_skel="$config_dir/groups_skel"
profiles_dir="$config_dir/profiles"
keys_skel="$config_dir/keys_skel"
themes_dir="$config_dir/themes"
themes_num=("$themes_dir"/*)
profiles_num=("$profiles_dir"/*)

_menu() {
    # resizing the terminal
    echo -ne '\e[8;30;103t'
    clear
    while true; do
        clear
        echo -e "\n Number of themes:   ${G}${#themes_num[@]}${Z}"
        echo -e " Number of profiles: ${G}${#profiles_num[@]}${Z}"
        echo -e " Profile in use:     ${G}${profile}${Z}\n\n"
        printf '%s\n' "${G}                                      ::g810-led-menu options::" \
                        "                       ┌────────────────────────────────────────────────────┐" \
                        "                       │  1) Create a profile  4) Edit keys profile skel    │" \
                        "                       │  2) Delete a profile  5) Edit groups profile skel  │" \
                        "                       │  3) Switch profile    6) Edit a theme              │" \
                        "                       │  ${R}X) Exit${G}              7) Edit a profile            │" \
                        "                       └────────────────────────────────────────────────────┘" \
                        "                                           Select an item${Z}" \
        ""

        read -rsn 1 option
        case "$option" in
            1) _createProfile ;;
            2) _deleteProfile ;;
            3) _switchProfile ;;
            4) _editFiles keys ;;
            5) _editFiles groups ;;
            6) _editFiles theme ;;
            7) _editFiles profile ;;
            [xX]) clear; exit ;;
            *) continue ;;
        esac
    done
}

blank_line() { printf '\n'; }

_cancel() {
    case $REPLY in
        [cC])
            profile=$(sed -n '1s/# //p' "$etc_confdir"/profile)
            printf '%s\n' " ${R}Selection cancelled...${Z}"
            rm "$profiles_dir"/{profile,group}_skel 2> /dev/null
            sleep 2
            _menu
        ;;
    esac
}

_editFiles() {

    __editMenu() {
        local profile_name
        clear
        blank_line
        select profile_name in $(find . -type f -printf '%f\n' | sort); do
            _cancel
            vim "$profile_name"
            break
        done
    }

    case $1 in
        groups) vim "$groups_skel" ;;
        keys) vim "$keys_skel" ;;
        profile)
            cd "$profiles_dir" || exit 1
            blank_line
            PS3=""$'\n'" ${G}Choose a RGB profile to edit or [C]ancel: ${Z}"
            __editMenu
        ;;
        theme)
            cd "$themes_dir" || exit 1
            blank_line
            PS3=""$'\n'" ${G}Choose a theme to edit or [C]ancel: ${Z}"
            __editMenu
        ;;
    esac

}

# Polybar module to display the profile in use and to switch between profiles,
# using the g810_switch_profile script.
#
# [module/ksp-ipc]
# type = custom/ipc
# hook-0 = echo "%{F$(xrdb -query | awk '/color4:/{print $NF}')}$(sed -n '1s/#//p' /etc/g810-led/profile) %{F-}"
# initial = 1
# format = <output>
# format-prefix = "   "
# format-prefix-foreground = ${colors.green}
# format-padding = 1
#
# Edit the line below according to your terminal emulator,
# to open a floating terminal with the g810_switch_profile script.
# click-left = urxvtc -name floaterm -geometry 60x12 -e g810_switch_profile & disown
#
# This function updates the logitech logo and the mute key in polybar
# _keyboardHook() {

#     local get_sink_mute muteKeyOn
#     get_sink_mute=$(pactl get-sink-mute "$(pactl get-default-sink)")
#     muteKeyOn=$(awk '/^var color1/{print $NF}' "$etc_profiles"/"$profile")

