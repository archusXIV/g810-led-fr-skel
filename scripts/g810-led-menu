#         action "#ksp-ipc.hook.0" >/dev/null 2>&1

#     [[ -s $XDG_RUNTIME_DIR/scratchpad_hidden.list ]] && \
#         sudo "$myModelBinary" -fx breathing logo fb4934 5
#     [[ ${get_sink_mute} == 'Mute: yes ' ]] && \
#         sudo "$myModelBinary" -k mute "$muteKeyOn"

# }

_deleteProfile() {

    cd "$etc_profiles" || exit 1
    clear

    echo -e "\n ${G}In use: $profile${Z}\n"
    local profile_name
    PS3=""$'\n'" ${G}Choose a RGB profile to delete or [C]ancel: ${Z}"
    select profile_name in $(find . -type f -not -name "default" -printf '%f\n' | sort); do

        _cancel
        if [[ $profile_name == "$profile" ]]; then
            # if you want to remove the profile in use...
            sudo "$myModelBinary" -pp < default
            sudo rm "$profile_name"
            sudo cp -f "$etc_profiles/default" "$etc_confdir/profile"
            rm "$profiles_dir/$profile_name"
            # we have to update the menu (the profile name).
            profile="default"
            printf '%s\n' " ${R}profile $profile_name deleted.${Z}"
            sleep 2
        else
            sudo rm "$profile_name"
            rm "$profiles_dir/$profile_name"
            printf '%s\n' " ${R}profile $profile_name deleted.${Z}"
            sleep 2
        fi
        break
    done
    # we have to update the menu (number of existing profiles).
    profiles_num=("$profiles_dir"/*)
    # _keyboardHook

}

_ifProfileTypeIs() {

    case "${profile_type}" in
        [gG])
            cp "$groups_skel" "$profiles_dir/$profile_name"
            sed -i "1s/^/# $profile_name\n/" "$profile_name"
        ;;
        [kK])
            cp "$keys_skel" "$profiles_dir/$profile_name"
            sed -i "1s/^/# $profile_name\n/" "$profile_name"
        ;;
        [cC])
            printf '%s\n' " ${R}Selection cancelled...${Z}"
            sleep 2
            _menu
        ;;
        *)
            printf '%s\n' " ${R}Wrong option $profile_type.${Z}"
            sleep 2
            _menu
        ;;
    esac

    clear

}

_saveAs() {

    sudo mkdir -p "$etc_profiles"
    sudo cp -f "$profile_name" "$etc_profiles/$profile_name"
    sudo chmod +r "$etc_profiles/$profile_name"

    read -rp " ${G}Apply $profile_name? [Y/n]: ${Z}" apply
    case "$apply" in
        [yY])
            sudo "$myModelBinary" -pp < "$etc_profiles/$profile_name"
            sudo cp -f "$etc_profiles/$profile_name" "$etc_confdir"/profile
            _keyboardHook
            profile="$profile_name"
            profiles_num=("$profiles_dir"/*)
        ;;
        *)
            profiles_num=("$profiles_dir"/*)
            _menu
        ;;
    esac

}

_createProfile() {

    cd "$profiles_dir" || exit 1
    clear

    declare -a XresourcesColors=(
        color1 color2 color3 color4 color5 color6 color7
    )

    # ~/.config/g810-led/themes/<myTheme> [variables] names
    declare -A ThemeColors=(
        [red]="${XresourcesColors[0]}"
        [grn]="${XresourcesColors[1]}"
        [ylw]="${XresourcesColors[2]}"
        [blu]="${XresourcesColors[3]}"
        [mag]="${XresourcesColors[4]}"
        [cyn]="${XresourcesColors[5]}"
        [wht]="${XresourcesColors[6]}"
    )

    local profile_name profile_type create_from colorvalue colorname
    blank_line
    read -rp " ${G}Create a [G]roups or a [K]eys profile, [C]ancel: ${Z}" profile_type
    _ifProfileTypeIs
    blank_line
    read -rp " ${G}Create [M]anually, from a [T]heme or from [X]resources: ${Z}" create_from
    blank_line

    case "$create_from" in
        [mM])
            read -rp " ${G}Enter a profile name: ${Z}" profile_name
            [[ -f $profiles_dir/$profile_name ]] && {
                printf '%s\n' " $profile_name already exists, exiting.."
                exit 1
            }
            for colorname in "${XresourcesColors[@]}"; do
                blank_line
                printf '%s\n' " ${G}color1=red color2=green color3=yellow color4=blue " \
                              " color5=magenta color6=cyan color7=white${Z}" \
                ""
                read -rp " ${G}Enter an hex color value for $colorname: ${Z}" colorvalue
                # testing the range and the number of characters for hexadecimal colors.
                [[ ! $colorvalue =~ ^[a-fA-F0-9]{6}$ ]] && {
                    printf '%s\n' " ${R}Hex colors must be 6 digits/numbers!" \
                    " 0 -> 9, a -> f: 88def2${Z}"
                    rm "$profile_name" 2>/dev/null
                    sleep 2
                    _menu
                }
                sed -i "s/var ${colorname}/var ${colorname} ${colorvalue}/" "$profile_name"
                clear
            done
        ;;
        [tT])
            if [[ -d $themes_dir ]]; then

                PS3=""$'\n'" ${G}Choose a theme or [C]ancel: ${Z}"
                select profile_name in $(find "$themes_dir" -type f -printf '%f\n' | sort); do
                    [[ -f $profiles_dir/$profile_name ]] && {
                        printf '%s\n' " ${R}profile $profile_name already exists, exiting...${Z}"
                        exit 1
                    }
                    _cancel

                    for key in "${!ThemeColors[@]}"; do
                        colorname="${ThemeColors[${key}]}"
                        colorvalue=$(
                            awk -F'#' -v K="$key" '
                                $0 ~ K { print $3; exit }
                            ' "$themes_dir/$profile_name"
                        )
                        printf '%s\n' "$colorvalue"
                        sed -i "s/var ${colorname}/var ${colorname} ${colorvalue}/" \
                        "$profiles_dir/$profile_name"
                    done
                    break

                done
            else
                printf '%s\n' " ${R}$themes_dir does not exist...exiting${Z}" && exit 1
            fi
        ;;
        [xX])
            if [[ -e $HOME/.Xresources ]]; then

                read -rp " ${G}Enter a profile name: ${Z}" profile_name
                [[ -f $profiles_dir/$profile_name ]] && {
                    printf '%s\n' " ${R}$profile_name already exists, exiting...${Z}"
                    exit 1
                }

                for colorname in "${XresourcesColors[@]}"; do
                    colorvalue=$(
                        xrdb -query | awk -F'#' -v X="$colorname" '$0 ~ X { print $2; exit }'
                    )
                    printf '%s\n' "$colorvalue"
                    sed -i "s/var ${colorname}/var ${colorname} ${colorvalue}/" "$profile_name"
                done

            else
                printf '%s\n' " ${R}$HOME/.Xresources does not exist...exiting${Z}" && exit 1
            fi
        ;;
        *)
            printf '%s\n' " ${R}Wrong option '$create_from'...exiting${Z}" && exit 1
        ;;
    esac

    _saveAs

}

_switchProfile() {

    cd "$profiles_dir" || exit 1
    clear
    echo -e "\n ${G}In use: $profile${Z}\n"

    local profile_name
    PS3=""$'\n'" ${G}Choose a RGB profile or [C]ancel: ${Z}"
    select profile_name in $(find . -type f -printf '%f\n' | sort); do

        _cancel
        sudo "$myModelBinary" -pp < "$profile_name"
        sudo cp -f "$etc_profiles/$profile_name" "$etc_confdir"/profile
        printf '%s\n' " ${G}profile $profile_name selected.${Z}"
        sleep 2
        break

    done

    # _keyboardHook
    profile="$profile_name"

}

_menu "${@}"